
def predict_score(hours):
    score = 5 + (9.5 * hours)


    if score > 100:
        score = 100

    return round(score, 2)


print("===================================")
print("   Student Score Prediction App")
print("===================================")

try:
    study_hours = float(input("Enter Study Hours: "))

    if study_hours < 0:
        print("Study hours cannot be negative.")
    else:
        predicted = predict_score(study_hours)
        print(f"\nPredicted Score: {predicted}%")

except ValueError:
    print("Please enter a valid number.")
