# ============================================================
# PROJECT IMPROVEMENT TASK
# Student Score Analysis
# ============================================================

# Import required libraries
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# 1. CREATE DATASET
# ============================================================

# Create sample student data
data = {
    "Name": ["Anu", "Bala", "Chitra", "Divya", "Esha", "Fathima", "Gokul"],
    "Hours_Studied": [2, 3, 4, 5, 6, 7, 8],
    "Score": [45, 55, 65, 72, 80, 88, 92]
}

# Convert the data into a pandas DataFrame
df = pd.DataFrame(data)


# ============================================================
# 2. DISPLAY DATASET
# ============================================================

print("=" * 50)
print("STUDENT SCORE ANALYSIS")
print("=" * 50)

print("\nDataset:")
display(df)


# ============================================================
# 3. DATASET EXPLORATION
# ============================================================

# Display the number of rows and columns
print("\nDataset Shape:")
print(df.shape)

# Display column names
print("\nColumn Names:")
print(df.columns.tolist())

# Display first five records
print("\nFirst Five Records:")
display(df.head())


# ============================================================
# 4. CHECK MISSING VALUES
# ============================================================

# Check for missing values in each column
print("\nMissing Values:")
print(df.isnull().sum())


# ============================================================
# 5. STATISTICAL ANALYSIS
# ============================================================

# Generate descriptive statistics
print("\nStatistical Summary:")
display(df.describe())

# Calculate average score
average_score = df["Score"].mean()

print("\nAverage Score:", round(average_score, 2))


# ============================================================
# 6. HIGHEST AND LOWEST SCORE
# ============================================================

# Find the highest score
highest_score = df["Score"].max()

# Find the lowest score
lowest_score = df["Score"].min()

# Find students with highest and lowest scores
highest_student = df.loc[df["Score"].idxmax(), "Name"]
lowest_student = df.loc[df["Score"].idxmin(), "Name"]

print("\nHighest Score:")
print(highest_student, "-", highest_score)

print("\nLowest Score:")
print(lowest_student, "-", lowest_score)


# ============================================================
# 7. DATA VISUALIZATION
# ============================================================

# Create a scatter plot showing study hours and scores
plt.figure(figsize=(8, 5))

plt.scatter(
    df["Hours_Studied"],
    df["Score"]
)

plt.title("Hours Studied vs Examination Score")
plt.xlabel("Hours Studied")
plt.ylabel("Score")
plt.grid(True)

plt.show()


# ============================================================
# 8. CONCLUSION
# ============================================================

print("\n" + "=" * 50)
print("CONCLUSION")
print("=" * 50)

print("""
The student score dataset was successfully analyzed.

The notebook includes:
