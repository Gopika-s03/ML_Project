import matplotlib.pyplot as plt


students = ["A", "B", "C", "D", "E"]
marks = [78, 85, 90, 72, 88]
study_hours = [2, 4, 5, 3, 6]

plt.figure(figsize=(6, 4))
plt.scatter(study_hours, marks, color="blue", s=100)
plt.title("Study Hours vs Marks")
plt.xlabel("Study Hours")
plt.ylabel("Marks")
plt.grid(True)
plt.show()

plt.figure(figsize=(6, 4))
plt.bar(students, marks, color="green")
plt.title("Student Marks")
plt.xlabel("Students")
plt.ylabel("Marks")
plt.show()


days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
sales = [120, 150, 180, 170, 210, 250, 230]

plt.figure(figsize=(6, 4))
plt.plot(days, sales, marker="o", linewidth=2, color="red")
plt.title("Weekly Sales Trend")
plt.xlabel("Days")
plt.ylabel("Sales")
plt.grid(True)
plt.show()
